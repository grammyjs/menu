{
    "lock": false,
    "tasks": {
        "ok": "deno fmt --check && deno lint && deno task check",
        "check": "deno check --allow-import"
    },
    "fmt": {
        "indentWidth": 4,
        "proseWrap": "preserve"
    },
    "exclude": ["./node_modules/", "./out/", "./package-lock.json"]
}
